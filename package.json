{
  "name": "omp-home",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build web --logLevel warn && node server/main.ts",
    "dev": "node --watch server/main.ts --no-open",
    "build": "vite build web",
    "build:hub": "node scripts/build-hub.mjs",
    "tauri": "tauri",
    "build:app": "node scripts/build-app.mjs",
    "updater:json": "node scripts/updater-json.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
